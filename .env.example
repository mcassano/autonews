# Postgres connection string (Railway provides this automatically as a service variable
# reference in production, e.g. ${{Postgres.DATABASE_URL}}; for local dev, point at your own
# Postgres instance).
DATABASE_URL=postgres://user:password@localhost:5432/autonews

# OpenRouter API key, used by the worker for LLM-based story enrichment
# (geopolitical context / "why it matters" blurbs). Get one at https://openrouter.ai/
OPEN_ROUTER_API_KEY=

# Brave Search API key, used by the worker to ground enrichment blurbs in real search
# results rather than relying solely on the model's training data.
# Get one at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Model slug to request via OpenRouter for enrichment calls.
LLM_MODEL=anthropic/claude-haiku-4.5

# Max concurrent LLM enrichment calls per ingestion run.
INGEST_CONCURRENCY=5

# How far back to consider a feed item "new enough" to ingest, in hours.
INGEST_LOOKBACK_HOURS=48
